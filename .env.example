# 이 파일을 .env 로 복사한 뒤 값을 채우세요.  (cp .env.example .env)

# ── 기본 ─────────────────────────────────────────────
CLASS_NAME=OO학개론 AI
PORT=3000
# 처음 실행할 때 이 정보로 교수자 계정이 만들어집니다 (8자 이상).
ADMIN_USERNAME=prof
ADMIN_PASSWORD=

# 학생 자가 가입용 참여 코드. 비워두면 교수자 화면에서만 계정을 만듭니다.
CLASS_JOIN_CODE=

# AI 에게 주는 기본 지시문 (선택)
# CLASS_SYSTEM_PROMPT=당신은 OO학개론 수업의 AI 조교입니다. 정답을 바로 주기보다 풀이 과정을 설명하세요.

# ── Claude (Anthropic API) ───────────────────────────
# console.anthropic.com 에서 발급한 API 키.
# Max 요금제의 "포함 API 크레딧"을 연결한 Console 조직의 키를 쓰면 구독료 안에서 먼저 차감됩니다.
ANTHROPIC_API_KEY=
# 기본은 claude-opus-5-5 ($4/$20 per 1M 토큰). 비용을 줄이려면 아래 중 선택:
#   claude-sonnet-5-5  ($2/$10)    claude-haiku-5-5  ($0.10/$0.50)
ANTHROPIC_MODEL=claude-opus-5-5
# 생각 깊이: low | medium | high
ANTHROPIC_EFFORT=medium
ANTHROPIC_WEB_SEARCH=true
ANTHROPIC_WEB_SEARCH_MAX_USES=5

# ── Claude 에이전트 모드 (Claude Code 와 같은 엔진) ─────
AGENT_ENABLED=true
AGENT_MODEL=claude-opus-5-5
AGENT_MAX_TURNS=30
# 에이전트 1회 실행당 비용 상한 (USD)
AGENT_MAX_BUDGET_USD_PER_RUN=0.5
# 학생 코드 실행(Bash). 서버에서 실제 명령이 실행되므로, 전용 VM/컨테이너에서만 켜세요.
AGENT_ALLOW_BASH=false

# ── OpenAI (선택) ────────────────────────────────────
OPENAI_API_KEY=
# 모델 이름을 직접 지정해야 켜집니다 (platform.openai.com 의 현재 모델 목록 확인).
OPENAI_MODEL=
OPENAI_WEB_SEARCH=true

# ── OpenAI 호환 API (선택, 최대 5개: COMPAT_1_ ~ COMPAT_5_) ──
# 종량제 API 키나 직접 띄운 로컬 모델만 연결하세요.
# (GLM Coding Plan·Kimi Code·MiniMax Token Plan·Alibaba Coding Plan 같은 "구독 플랜" 키는
#  각 회사 약관이 자기 앱·웹사이트 백엔드에서 쓰는 것을 금지합니다.)
# 가격은 USD / 100만 토큰. 비워두면 비용이 0으로 기록됩니다. 2026-10 기준이니 콘솔에서 확인하세요.
#
# 예) DeepSeek (데이터는 중국 서버에 저장. 평일 한국 시간 10–13시, 15–19시는 피크 요금)
# COMPAT_1_NAME=DeepSeek
# COMPAT_1_BASE_URL=https://api.deepseek.com
# COMPAT_1_API_KEY=sk-...
# COMPAT_1_MODEL=deepseek-flash
# COMPAT_1_PRICE_INPUT=0.30
# COMPAT_1_PRICE_CACHED_INPUT=0.006
# COMPAT_1_PRICE_OUTPUT=1.20
#
# 예) Qwen (Alibaba Model Studio 싱가포르 리전)
# COMPAT_2_NAME=Qwen
# COMPAT_2_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# COMPAT_2_API_KEY=sk-...
# COMPAT_2_MODEL=qwen3.7-plus
# COMPAT_2_PRICE_INPUT=0.40
# COMPAT_2_PRICE_CACHED_INPUT=0.08
# COMPAT_2_PRICE_OUTPUT=1.60
#
# 예) 로컬 모델 (Ollama). API 키는 아무 글자나, 가격은 비워 두면 0
# COMPAT_3_NAME=로컬 모델
# COMPAT_3_BASE_URL=http://localhost:11434/v1
# COMPAT_3_API_KEY=ollama
# 모델 이름은 ollama list 로 확인. 동시 5명이면 Ollama 쪽에 OLLAMA_NUM_PARALLEL=5 필수
# COMPAT_3_MODEL=모델이름
# 생각 강도(low|medium|high). 로컬 모델은 low 가 빠름. 서버가 지원할 때만 효과
# COMPAT_3_REASONING_EFFORT=low
# 서버별 추가 옵션(JSON). 예: vLLM 의 Qwen 생각 모드 끄기
# COMPAT_3_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}
# 에이전트 모드(학생 작업 폴더에서 파일 작업)도 켜기. 도구 호출을 지원하는 모델이어야 함
# COMPAT_3_AGENT=true
# 에이전트 1회 실행에서 도구를 쓰는 최대 단계 수
# COMPAT_3_MAX_STEPS=15
# 도구 호출(웹 검색·파일 작업)을 지원하지 않는 모델이면 false
# COMPAT_3_TOOLS=true
# 사용량 집계를 지원하지 않는 서버라 오류가 나면 false
# COMPAT_3_STREAM_USAGE=true

# ── 웹 검색 (Claude 이외 모델용) ──────────────────────
# searxng: 직접 설치하는 무료 메타검색엔진 (로컬 모델과 함께 쓰기 좋음, README 참고)
# tavily : tavily.com API 키 (무료 사용량 있음)
# 비워 두면 Claude 이외 모델은 웹 검색 없이 답합니다.
SEARCH_PROVIDER=
SEARXNG_URL=http://localhost:8080
TAVILY_API_KEY=
SEARCH_MAX_RESULTS=5

# ── 에이전트 코드 실행 (Claude 이외 모델의 에이전트용) ──
# docker: 실행할 때마다 격리 컨테이너를 만들어 그 안에서만 실행 (인터넷 차단). off: 끔
# 먼저 이미지를 만드세요: docker build -t class-ai-sandbox sandbox/
CODE_EXEC=off
CODE_EXEC_IMAGE=class-ai-sandbox
CODE_EXEC_TIMEOUT_SEC=30
CODE_EXEC_MEMORY=512m
CODE_EXEC_CPUS=1
# 실행 중 인터넷 허용 (기본 차단)
CODE_EXEC_NETWORK=false
# gVisor 를 설치했다면 runsc 로 더 강하게 격리
CODE_EXEC_DOCKER_RUNTIME=

# 모델 라이선스가 요구하는 표기 (학생 화면 하단에 표시). 예: Powered by HyperCLOVA X
MODEL_NOTICE=

# ── 사용 한도 ────────────────────────────────────────
# 학생 1명당 하루 한도 (0 = 무제한). 비용(USD) 한도를 권장합니다.
# 토큰 한도는 에이전트 모드가 캐시된 내용을 반복해서 읽어 숫자가 크게 나오므로 기본은 끔.
DAILY_COST_LIMIT_USD_PER_STUDENT=1.0
DAILY_TOKEN_LIMIT_PER_STUDENT=0
# 이번 달 전체 예산 (USD). 넘으면 학생 요청을 막습니다. Console 의 지출 한도도 함께 설정하세요.
MONTHLY_BUDGET_USD=100

# ── 운영 ─────────────────────────────────────────────
# HTTPS(리버스 프록시) 뒤에서 운영하면 둘 다 true
SECURE_COOKIES=false
TRUST_PROXY=false
# 화면·기록 기능만 시험할 때 (AI 호출 없음)
MOCK_PROVIDER=false
